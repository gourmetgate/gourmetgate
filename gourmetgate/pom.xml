<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>app.gourmetgate</groupId>
    <artifactId>gourmetgate-root</artifactId>
    <version>${gourmetgate.version}</version>
  </parent>

  <artifactId>gourmetgate</artifactId>
  <packaging>pom</packaging>

  <properties>
    <org.eclipse.scout.rt.version>25.2.14</org.eclipse.scout.rt.version>
    <org.jooq.version>3.20.2</org.jooq.version>
    <org.postgresql.version>42.7.8</org.postgresql.version>
    <org.hibernate.orm.version>6.6.40.Final</org.hibernate.orm.version>
    <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
    <master_npm_release_dependency_mapping>--mapping.0.regex=@eclipse-scout --mapping.0.version=${org.eclipse.scout.rt.version}</master_npm_release_dependency_mapping>

    <!-- docker image build settings -->
    <!-- build target (push) -->
    <docker.app.image.registry>ghcr.io/gourmetgate</docker.app.image.registry> <!-- set a desired registry before using profile exec.docker.image (e.g. registry.hub.docker.com/yourusername) -->
    <docker.app.image.tag>${gourmetgate.version}</docker.app.image.tag>
    <!-- java source image (pull) -->
    <docker.java.image.name>eclipse-temurin</docker.java.image.name>
    <docker.java.image.tag>24-jdk-noble</docker.java.image.tag>
    <docker.java.image>${docker.java.image.name}:${docker.java.image.tag}</docker.java.image>
  </properties>

  <modules>
    <!-- Core modules -->
    <module>../gourmetgate.ui</module>
    <module>../gourmetgate.api</module>
    <module>../gourmetgate.core</module>
    <module>../gourmetgate.data</module>
    <module>../gourmetgate.persistence</module>

    <!-- App modules -->
    <module>../gourmetgate.app</module>
    <module>../gourmetgate.app.dev</module>
    <module>../gourmetgate.app.image</module>

    <!-- DB modules -->
    <module>../gourmetgate.db</module>
  </modules>

  <profiles>
    <profile>
      <!-- required for .app.image module to apply filtering on config.properties -->
      <id>filter.config.property</id>
      <activation>
        <file>
          <exists>${basedir}${file.separator}src${file.separator}main${file.separator}resources${file.separator}config.properties</exists>
        </file>
      </activation>
      <build>
        <resources>
          <resource>
            <directory>${project.basedir}${file.separator}src${file.separator}main${file.separator}resources</directory>
            <filtering>true</filtering>
          </resource>
        </resources>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>properties-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!--  set property docker.app.image.registry before activating profile -->
      <id>exec.docker.image</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <!-- phase binding required for .app.image module to build and publish docker image -->
              <groupId>com.google.cloud.tools</groupId>
              <artifactId>jib-maven-plugin</artifactId>
              <executions>
                <execution>
                  <phase>package</phase>
                  <goals>
                    <goal>build</goal>
                  </goals>
                </execution>
              </executions>
              <configuration>
                <to>
                  <auth>
                    <username>github.actor</username>
                    <password>${REGISTRY_PASSWORD}</password>
                  </auth>
                </to>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-dependency-plugin</artifactId>
          <configuration>
            <overWriteReleases>false</overWriteReleases>
            <overWriteSnapshots>true</overWriteSnapshots>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <dependencyManagement>
    <dependencies>
      <!-- External Dependencies -->
      <dependency>
        <groupId>org.eclipse.scout.rt</groupId>
        <artifactId>org.eclipse.scout.rt</artifactId>
        <version>${org.eclipse.scout.rt.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jooq</groupId>
        <artifactId>jooq-parent</artifactId>
        <version>${org.jooq.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${org.postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-core</artifactId>
        <version>${org.hibernate.orm.version}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.persistence</groupId>
        <artifactId>jakarta.persistence-api</artifactId>
        <version>${jakarta.persistence.version}</version>
      </dependency>

      <!-- Application dependencies -->
      <dependency>
        <groupId>app.gourmetgate</groupId>
        <artifactId>gourmetgate.ui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>app.gourmetgate</groupId>
        <artifactId>gourmetgate.app</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>app.gourmetgate</groupId>
        <artifactId>gourmetgate.app.dev</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>app.gourmetgate</groupId>
        <artifactId>gourmetgate.app.image</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>app.gourmetgate</groupId>
        <artifactId>gourmetgate.app.zip</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>app.gourmetgate</groupId>
        <artifactId>gourmetgate.api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>app.gourmetgate</groupId>
        <artifactId>gourmetgate.core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>app.gourmetgate</groupId>
        <artifactId>gourmetgate.persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>app.gourmetgate</groupId>
        <artifactId>gourmetgate.data</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>app.gourmetgate</groupId>
        <artifactId>gourmetgate.db</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>eclipse.release</id>
      <name>eclipse-release-repo</name>
      <url>https://repo.eclipse.org/content/groups/releases/</url>
    </repository>
    <repository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>eclipse.snapshot</id>
      <name>eclipse-snapshot-repo</name>
      <url>https://repo.eclipse.org/content/groups/snapshots/</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>eclipse.release</id>
      <name>eclipse-release-repo</name>
      <url>https://repo.eclipse.org/content/groups/releases/</url>
    </pluginRepository>
    <pluginRepository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>eclipse.snapshot</id>
      <name>eclipse-snapshot-repo</name>
      <url>https://repo.eclipse.org/content/groups/snapshots/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
